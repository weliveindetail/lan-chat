[Unit]
Description=LAN chat page for local Ollama
After=network-online.target ollama.service lan-chat-web.service
Wants=network-online.target lan-chat-web.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=lan-chat
Group=lan-chat
# install.sh sets the real address and LAN range in lan-chat.service.d/lan.conf
Environment=LAN_CHAT_IP=127.0.0.1
ExecStart=/usr/bin/python3 -I /opt/lan-chat/server.py --host ${LAN_CHAT_IP} --port 8080 --tls-cert /etc/lan-chat/cert.pem --tls-key /etc/lan-chat/key.pem --http-port 8081 --web-socket /run/lan-chat-web/web.sock
Restart=on-failure
RestartSec=30
UMask=0077

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

# LAN clients and Ollama only, no route to the internet. Web access goes through lan-chat-web.
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
